# ApplyPilot optional runtime configuration.
# ChatGPT authentication tokens are stored in the operating-system credential store.

# Local inference guardrails (apply per ApplyPilot process)
APPLYPILOT_LLM_MAX_CALLS=0       # 0 means no local request ceiling
APPLYPILOT_LLM_CONCURRENCY=2     # maximum simultaneous Responses requests

# Auto-Apply (optional)
CAPSOLVER_API_KEY=

# Proxy (optional, for scraping)
# PROXY=host:port:user:pass
